MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_TOKEN=replace-with-bot-access-token
DATA_DIR=/app/data
POLL_SECONDS=5
# Image limits. Each image file must be named START-END (for example 81-100.jpg).
MAX_IMAGES=50
MAX_CARDS_PER_IMAGE=40
MAX_IMAGE_BYTES=10485760
MAX_BATCH_BYTES=52428800
MAX_REPORT_BYTES=20971520
# Extractor tuning. Leave empty for automatic detection.
# CODE_LEN: force the code length, e.g. 15. LAYOUT: auto, right, left or middle.
CODE_LEN=
LAYOUT=auto
# Comma-separated Mattermost user IDs. Empty allows any user who can DM the bot.
ALLOWED_USER_IDS=
