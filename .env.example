MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_TOKEN=replace-with-bot-access-token
# Full endpoint URL, not just the backend hostname.
BACKEND_URL=http://backend:8000/v1/reports
BACKEND_TOKEN=
FORMAT_ID=default
DATA_DIR=/app/data
POLL_SECONDS=5
BACKEND_TIMEOUT=180
MAX_IMAGES=20
MAX_IMAGE_BYTES=10485760
MAX_BATCH_BYTES=52428800
MAX_REPORT_BYTES=20971520
# Comma-separated Mattermost user IDs. Empty allows any user who can DM the bot.
ALLOWED_USER_IDS=
